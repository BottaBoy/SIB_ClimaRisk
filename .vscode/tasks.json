{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SIB: Resume Latest Complete Analysis (No Deploy)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/run_complete_analysis.py",
        "--resume-run-id",
        "latest",
        "--no-deploy",
        "--dynamic-max-tracks",
        "1200",
        "--memory-budget-gb",
        "6"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Monitor Complete Analysis Run",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/monitor_run.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Babysit Complete Analysis Run",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "RUN_ID='${input:completeAnalysisRunId}'; SESSION=\"babysit-${input:completeAnalysisRunId}\"; LOG_FILE=\"/home/ubuntu/sib-work/logs/babysit_complete_analysis_${input:completeAnalysisRunId}.log\"; cd /home/ubuntu/sib-work; if tmux has-session -t \"$SESSION\" 2>/dev/null; then echo \"Reusing tmux session $SESSION\"; else tmux new-session -d -s \"$SESSION\" \"bash -lc '/home/ubuntu/sib-work/backend/.venv/bin/python scripts/babysit_complete_analysis_run.py --run-id $RUN_ID --poll-seconds 60 --stale-after-minutes 20 --silent-hang-after-minutes 30 --restart-delay-seconds 30 2>&1 | tee -a $LOG_FILE'\"; echo \"Started tmux session $SESSION\"; fi; exec tmux attach -t \"$SESSION\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      }
    },
    {
      "label": "SIB: Rebuild Frontend Artefacts (Guadeloupe Only)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/rerun_case_studies_light.py",
        "--territories",
        "guadeloupe",
        "--proxy-max-points-total",
        "600",
        "--proxy-max-points-per-feature",
        "6",
        "--proxy-dynamic-max-tracks",
        "100",
        "--map-dynamic-max-tracks",
        "300"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Rebuild Frontend Artefacts (Guadeloupe + Martinique)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/rerun_case_studies_light.py",
        "--territories",
        "guadeloupe",
        "martinique",
        "--proxy-max-points-total",
        "600",
        "--proxy-max-points-per-feature",
        "6",
        "--proxy-dynamic-max-tracks",
        "100",
        "--map-dynamic-max-tracks",
        "300"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Deploy Only (sib.shared.elio.dev)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/deploy_only.py",
        "--vhost",
        "sib.shared.elio.dev"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Deploy Only (Both Servers)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/deploy_only.py",
        "--vhost",
        "both"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Snapshot Latest Run Web Artefacts",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/snapshot_run_web_artifacts.py",
        "--run-id",
        "latest-published"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Snapshot Latest Run Web Artefacts (Guadeloupe Only)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/snapshot_run_web_artifacts.py",
        "--run-id",
        "latest-published",
        "--territories",
        "guadeloupe"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Deploy Archived Latest Run (sib.dev.elio.bottagisio.com)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/deploy_only.py",
        "--run-id",
        "latest-published",
        "--vhost",
        "sib.dev.elio.bottagisio.com"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    },
    {
      "label": "SIB: Deploy Archived Latest Run (Guadeloupe Only -> sib.dev.elio.bottagisio.com)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/deploy_only.py",
        "--run-id",
        "latest-published",
        "--territories",
        "guadeloupe",
        "--vhost",
        "sib.dev.elio.bottagisio.com"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "none",
        "isDefault": false
      }
    }
  ],
  "inputs": [
    {
      "id": "completeAnalysisRunId",
      "type": "promptString",
      "description": "Complete-analysis run ID to babysit",
      "default": "20260611_075636"
    }
  ]
}
