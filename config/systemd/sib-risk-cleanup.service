[Unit]
Description=SIB Cyclone Risk API cleanup expired job artifacts

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/sib-work/backend
EnvironmentFile=-/home/ubuntu/sib-work/config/systemd/sib-risk-api.env
Environment=SIB_RISK_JOB_ROOT=/var/lib/sib-risk/jobs
Environment=SIB_RISK_DB_PATH=/var/lib/sib-risk/sib.sqlite3
Environment=SIB_RISK_JOB_TTL_HOURS=168
ExecStart=/home/ubuntu/sib-work/backend/.venv/bin/python scripts/cleanup_expired_jobs.py
