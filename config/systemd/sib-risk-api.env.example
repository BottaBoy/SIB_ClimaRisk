# Copy to sib-risk-api.env and adjust paths if needed.
SIB_RISK_JOB_ROOT=/var/lib/sib-risk/jobs
SIB_RISK_JOB_TTL_HOURS=24
SIB_RISK_MAX_UPLOAD_MB=50
SIB_RISK_STORM_YEARS=10000
SIB_RISK_DEMO_RESULT_PATH=/home/ubuntu/sib-work/web/data/guadeloupe-complete-analysis.json
SIB_RISK_DATA_ROOT=/home/ubuntu/sib-work/data
SIB_RISK_HAZARD_STORM_PATH=/home/ubuntu/sib-work/data/hazards/tc_hazard_guadeloupe.h5
SIB_RISK_HAZARD_STORM_CMCC_PATH=/home/ubuntu/sib-work/data/hazards/tc_hazard_guadeloupe_CMCC.h5
SIB_RISK_STORM_PARQUET_PATH=/home/ubuntu/sib-work/data/hazards/storm_ds
SIB_RISK_STORM_CMCC_PARQUET_PATH=/home/ubuntu/sib-work/data/hazards/storm_ds_CMCC
SIB_RISK_CORS_ALLOWED_ORIGINS=https://app.sib.elio.dev,https://sib.dev.elio.bottagisio.com
SIB_RISK_IMPACT_ENGINE_MODE=climada
SIB_RISK_ALLOW_CLIMADA_FALLBACK=false
SIB_RISK_CLIMADA_METRIC_CRS=EPSG:3857
SIB_RISK_CLIMADA_MAX_POINTS_PER_FEATURE=300
SIB_RISK_CLIMADA_TOP_EVENTS_COUNT=20
SIB_RISK_EXAMPLE_QGIS_POINTS_PATH=/home/ubuntu/sib-work/data/examples/QGIS_Points_04_08_25.csv
SIB_RISK_EXAMPLE_QGIS_LINES_PATH=/home/ubuntu/sib-work/data/examples/QGIS_Lignes_04_08_25.csv
SIB_RISK_EXAMPLE_QGIS_POLYGONS_PATH=/home/ubuntu/sib-work/data/examples/QGIS_Polygones_04_08_25.csv
