########### Kill all process

# Check active babysitters and active runs
tmux ls || true
echo '---'
ps -eo pid,ppid,stat,args | awk '
  /\/home\/ubuntu\/sib-work\/scripts\/(babysit_.*_run|run_.*analysis|run_.*comparison|run_.*sensitivity)\.py/ {
    print
  }
'
# Kill babysitters first, then kill any matching runs
tmux ls 2>/dev/null | awk -F: '/^babysit-/ {print $1}' | xargs -r -n1 tmux kill-session -t

ps -eo pid=,args= | awk '
  /\/home\/ubuntu\/sib-work\/scripts\/(babysit_.*_run|run_.*analysis|run_.*comparison|run_.*sensitivity)\.py/ {
    print $1
  }
' | xargs -r kill -TERM

sleep 2

ps -eo pid=,args= | awk '
  /\/home\/ubuntu\/sib-work\/scripts\/(babysit_.*_run|run_.*analysis|run_.*comparison|run_.*sensitivity)\.py/ {
    print $1
  }
' | xargs -r kill -KILL
